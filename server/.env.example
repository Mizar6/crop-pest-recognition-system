# ============================================
# 农作物病虫害叶片识别系统 - 环境配置模板
# 用法：复制为 .env 后按自己的环境修改
#   Windows : copy .env.example .env
#   macOS/Linux : cp .env.example .env
# ============================================

# ---------- 数据库 ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的数据库密码
DB_NAME=db_plant_diseases

# ---------- 上传目录（识别图片/视频存放位置） ----------
# Windows 示例：D:/uploads
# macOS/Linux 示例：./uploads
UPLOAD_ROOT=./uploads

# ---------- 模型 ----------
# 相对 server 目录的路径，或写绝对路径
MODEL_PATH=data/models/best.pt
MODEL_NAME=YOLO26s 病虫害检测模型
DEFAULT_CONF=0.25
DEFAULT_IMGSZ=640
# 没有 GPU 时改成 cpu
DEVICE=0

# ---------- AI（通义千问 / 阿里云百炼） ----------
# 不填也能用：识别、图鉴、药剂、图谱正常；问答与自动翻译不可用
DASHSCOPE_API_KEY=
RAG_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RAG_EMBEDDING_MODEL=text-embedding-v3
RAG_QA_MODEL=qwen-plus
RAG_TOP_K=4
RAG_HISTORY_LIMIT=10
VSTORE_DIR=data/vstore
